# ---------------------------------------------------------------------------
# Edge — counsellor knowledge assistant (Next.js frontend)
# Copy to .env.local for development. In production these come from the Helm
# ConfigMap / external Secret; NEXT_PUBLIC_* values are baked in at build time.
#
# Google sign-in is required: this app has no anonymous/open mode. Every
# protected route fails closed until NEXT_PUBLIC_GOOGLE_CLIENT_ID and
# SESSION_SECRET are both set (and match the backend's values).
# ---------------------------------------------------------------------------

# Edge backend (expert-ai-consultant). Server-side only.
EDGE_API_URL=http://localhost:3000
# Must equal the backend's API_KEY (server-to-server credential).
EDGE_API_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Google sign-in (required). Add the frontend origin (e.g. http://localhost:3101) as an
# authorised JavaScript origin on this OAuth client, and set the same client id on the
# backend as GOOGLE_OAUTH_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Must equal the backend's SESSION_SECRET (>= 32 chars); verifies the session cookie.
SESSION_SECRET=
# Mirrors the backend's ALLOWED_EMAIL_DOMAINS (display only; the backend enforces it).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=heubert.com,experteducation.com.au

# Public URL of this app (metadata base).
NEXT_PUBLIC_APP_URL=http://localhost:3101
